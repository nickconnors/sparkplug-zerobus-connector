# The environment variables the example configuration (sparkplug_connector/config/config.yaml) reads.
# Copy to .env or connector.env and fill in; keep the filled-in file out of git.

# Databricks: the Zerobus endpoint, the workspace, and the service principal that writes the table
ZEROBUS_ENDPOINT=<workspace-id>.zerobus.<region>.cloud.databricks.com
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_CLIENT_ID=<service principal application id>
DATABRICKS_CLIENT_SECRET=<its OAuth secret>

# The MQTT server (mqtts://<host>:8883 for TLS)
SPARKPLUG_MQTT_ENDPOINT=mqtt://<mqtt server>:1883
SPARKPLUG_MQTT_USERNAME=<mqtt user>
SPARKPLUG_MQTT_PASSWORD=<its password>

# Optional: the encrypted credential store (${credential:...} in the config) and encrypted config values
# CONNECTOR_MASTER_PASSWORD=<a strong password>

# Optional: the web UI login (web_ui.authentication.enabled: true)
# OAUTH_CLIENT_ID=<OAuth app client id>
# OAUTH_CLIENT_SECRET=<its secret>
# SESSION_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(32))">

# The Docker health check's port, if web_ui.port isn't 8001
# CONNECTOR_HEALTH_PORT=8001
