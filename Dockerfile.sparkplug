# The connector for Sparkplug B (no React web UI build; protobuf runs its fast upb implementation).
#
#   docker build -f Dockerfile.sparkplug -t unified-ot-connector-sparkplug \
#     --build-arg PIP_INDEX_URL=https://pypi.org/simple .
#   docker run --env-file connector.env -p 127.0.0.1:8090:8090 -v connector-wal:/app/wal unified-ot-connector-sparkplug
#
# The default command runs config/sparkplug.yaml (its header lists the environment variables);
# mount another config and pass --config to use it. The write-ahead log (SPARKPLUG_WAL=true) is in /app/wal:
# a volume there keeps it across container restarts.
FROM python:3.12-slim
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 CONNECTOR_WEB_HOST=0.0.0.0
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt
COPY unified_connector ./unified_connector
COPY config ./config
RUN mkdir -p /app/wal && useradd --create-home connector && chown -R connector /app
USER connector
EXPOSE 8090
ENTRYPOINT ["python", "-m", "unified_connector"]
CMD ["--config", "config/sparkplug.yaml"]
